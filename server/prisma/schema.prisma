generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  /// Stored lowercased and trimmed.
  email         String         @unique
  passwordHash  String
  displayName   String
  role          Role           @default(USER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
}

/// One row per issued refresh token. Tokens are rotated on every use; all tokens descended from
/// one login share a familyId so that reuse of an old token can revoke the whole chain.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  /// SHA-256 of the raw token. The raw value is never stored.
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  @@index([familyId])
  @@index([userId])
}

model Artist {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  bio       String?
  /// Image files live at <MEDIA_ROOT>/covers/<imageId>-{300,600}.webp. A new id on every upload.
  imageId   String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  albums    Album[]
  tracks    Track[]

  @@index([name])
}

model Album {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  artistId    String   @db.Uuid
  artist      Artist   @relation(fields: [artistId], references: [id], onDelete: Restrict)
  releaseYear Int?
  /// Cover files live at <MEDIA_ROOT>/covers/<coverId>-{300,600}.webp. A new id on every upload.
  coverId     String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tracks      Track[]

  @@index([artistId])
  @@index([createdAt])
}

enum TrackStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// Listeners only ever see READY tracks. Upload and transcoding fields arrive in Task 6.
model Track {
  id           String      @id @default(uuid()) @db.Uuid
  title        String
  albumId      String      @db.Uuid
  album        Album       @relation(fields: [albumId], references: [id], onDelete: Restrict)
  /// Usually the album artist; can differ for guest appearances.
  artistId     String      @db.Uuid
  artist       Artist      @relation(fields: [artistId], references: [id], onDelete: Restrict)
  trackNumber  Int
  durationMs   Int?
  status       TrackStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([albumId, trackNumber])
  @@index([artistId])
  @@index([status])
}
