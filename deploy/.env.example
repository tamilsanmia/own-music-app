# Copy to deploy/.env (gitignored). deploy.sh creates the Kubernetes Secret music-secrets from it.
# Generate values with: openssl rand -hex 32   (hex, so they are safe inside the Postgres URL)
# deploy/gen-secrets.sh fills in everything except ADMIN_EMAIL.
POSTGRES_PASSWORD=
JWT_SECRET=
STREAM_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
