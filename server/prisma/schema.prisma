generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  /// Stored lowercased and trimmed.
  email         String         @unique
  passwordHash  String
  displayName   String
  role          Role           @default(USER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
}

/// One row per issued refresh token. Tokens are rotated on every use; all tokens descended from
/// one login share a familyId so that reuse of an old token can revoke the whole chain.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  /// SHA-256 of the raw token. The raw value is never stored.
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  @@index([familyId])
  @@index([userId])
}
