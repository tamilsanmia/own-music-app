generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  /// pg_trgm: fuzzy, case-insensitive search on titles and names.
  extensions = [pg_trgm]
}

enum Role {
  ADMIN
  USER
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  /// Stored lowercased and trimmed.
  email         String         @unique
  passwordHash  String
  displayName   String
  role          Role           @default(USER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  likes         LikedTrack[]
  plays         PlayHistory[]
  playlists     Playlist[]
}

/// One row per issued refresh token. Tokens are rotated on every use; all tokens descended from
/// one login share a familyId so that reuse of an old token can revoke the whole chain.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  /// SHA-256 of the raw token. The raw value is never stored.
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  @@index([familyId])
  @@index([userId])
}

model Artist {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  bio       String?
  /// Image files live at <MEDIA_ROOT>/covers/<imageId>-{300,600}.webp. A new id on every upload.
  imageId   String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  albums    Album[]
  tracks    Track[]

  @@index([name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Artist_name_trgm_idx")
}

model Album {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  artistId    String   @db.Uuid
  artist      Artist   @relation(fields: [artistId], references: [id], onDelete: Restrict)
  releaseYear Int?
  /// Cover files live at <MEDIA_ROOT>/covers/<coverId>-{300,600}.webp. A new id on every upload.
  coverId     String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tracks      Track[]

  @@index([artistId])
  @@index([createdAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Album_title_trgm_idx")
}

enum TrackStatus {
  /// The admin is still sending the file in chunks.
  UPLOADING
  /// Uploaded and checked; waiting for the transcoding worker.
  PENDING
  PROCESSING
  READY
  FAILED
}

/// Listeners only ever see READY tracks.
/// Files: <MEDIA_ROOT>/tmp/<id>.part while uploading, originals/<id>.<originalExt> after,
/// and hls/<id>/{master.m3u8, 96k/, 160k/, 320k/} once READY.
model Track {
  id               String          @id @default(uuid()) @db.Uuid
  title            String
  albumId          String          @db.Uuid
  album            Album           @relation(fields: [albumId], references: [id], onDelete: Restrict)
  /// Usually the album artist; can differ for guest appearances.
  artistId         String          @db.Uuid
  artist           Artist          @relation(fields: [artistId], references: [id], onDelete: Restrict)
  trackNumber      Int
  durationMs       Int?
  status           TrackStatus     @default(UPLOADING)
  errorMessage     String?
  /// Name of the uploaded file, for the admin's reference.
  originalFilename String?
  /// Lowercase extension of the stored original, e.g. "flac".
  originalExt      String?
  /// Declared size of the upload in bytes.
  sizeBytes        Int?
  /// Codec, sample rate and channels of the original, from ffprobe.
  sourceInfo       String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  likes            LikedTrack[]
  plays            PlayHistory[]
  playlistItems    PlaylistTrack[]

  @@index([albumId, trackNumber])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Track_title_trgm_idx")
  @@index([artistId])
  @@index([status])
}

/// A listener's liked songs. Removed with the user or the track.
model LikedTrack {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String   @db.Uuid
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, trackId])
  @@index([userId, createdAt])
}

/// One row per counted play (the client reports a play after 30 s of listening).
model PlayHistory {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId  String   @db.Uuid
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  playedAt DateTime @default(now())

  @@index([userId, playedAt])
  @@index([userId, trackId, playedAt])
}

/// A listener's own playlist. Only the owner can see or change it.
model Playlist {
  id          String          @id @default(uuid()) @db.Uuid
  ownerId     String          @db.Uuid
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       PlaylistTrack[]

  @@index([ownerId, updatedAt])
}

/// One entry in a playlist. The same track may appear more than once, so entries have their
/// own id. `position` is 0-based and kept contiguous by the service.
model PlaylistTrack {
  id         String   @id @default(uuid()) @db.Uuid
  playlistId String   @db.Uuid
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId    String   @db.Uuid
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position   Int
  addedAt    DateTime @default(now())

  @@index([playlistId, position])
  @@index([trackId])
}
